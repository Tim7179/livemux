# ── Server ──────────────────────────────────────────────────
NGINX_RTMP_PORT=1935
NGINX_HTTP_PORT=80

# ── API ─────────────────────────────────────────────────────
API_PORT=3000
ADMIN_API_KEY=change_me_in_production

# Shared secret for internal nginx→API hooks (recording notify).
# Defaults to ADMIN_API_KEY if not set.
INTERNAL_TOKEN=change_me_too

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_secret

# ── HLS ──────────────────────────────────────────────────────
HLS_FRAGMENT_SECONDS=2
HLS_PLAYLIST_LENGTH=10

# ── Recording ────────────────────────────────────────────────
RECORDING_ENABLED=true

# ── Claude AI (optional – enables code review feature) ────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
